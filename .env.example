# AP / Studio — environment variable names only (no secrets)
# Copy to .env and fill in values for local or Docker Compose.

# --- PUBLIC / SUPABASE ---
# Vercel UI tip: do NOT use the NEXT_PUBLIC_ prefix for Supabase.
# Use private names below. Vercel will not show the "public framework prefix" warning.
# URL + anon still reach the browser via layout injection (safe; RLS applies).
# Prefer private names on Vercel (no NEXT_PUBLIC_ prefix).
# URL + anon are still sent to the browser at runtime (safe by design / RLS).
# Do NOT put SERVICE_ROLE under NEXT_PUBLIC_ — keep it server-only.

# Any of these work; app resolves in order (JWT eyJ preferred when present).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- SUPABASE server ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# STORAGE_BUCKET deprecated — AP uses Cloudflare R2 only
# STORAGE_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=


# --- AI / MEDIA ---
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_TRANSCRIBE_MODEL=
REPLICATE_API_TOKEN=
REPLICATE_API_KEY=
REPLICATE_MUSIC_MODEL=
REPLICATE_MUSIC_MODEL_VERSION=
REPLICATE_MUSICGEN_MODEL=
REPLICATE_MUSICGEN_MODEL_VERSION=
REPLICATE_MUSICGEN_VERSION=
REPLICATE_MUSICGEN_MELODY_VERSION=
REPLICATE_WEBHOOK_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_MUSIC_MODEL=
OPENAI_API_KEY=

# --- PAYMENTS ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- AUDIO / FFMPEG ---
FFMPEG_PATH=
# In Docker Compose default: /usr/bin/ffmpeg

# --- PIPELINE / FEATURE FLAGS ---
AUDIO_PIPELINE_MODE=
ROEX_API_KEY=
ROEX_ENV=
ROEX_WEBHOOK_URL=
ROEX_WEBHOOK_SECRET=
ROEX_ALLOW_PRODUCE=
ROEX_ALLOW_FULL=
AP_SKIP_ASR=
AP_ASR_TIMEOUT_MS=
AP_ALLOW_DEV_UNLOCK=
AP_DOWNLOADS_OPEN=
DEV_MODE=

# --- RATE LIMITS ---
MAX_GENERATIONS_PER_USER_PER_DAY=
MAX_PREVIEW_GENERATIONS_PER_DAY=
MAX_FULL_GENERATIONS_PER_DAY=
MUSIC_FULL_DURATION_SEC=
MUSIC_PREVIEW_DURATION_SEC=

# --- WORKER (self-hosting) ---
WORKER_ID=
WORKER_POLL_MS=
WORKER_TICK_MS=

# --- EMAIL (Resend) ---
RESEND_API_KEY=
# Verified sender, e.g. AP Studio <noreply@apstudio.site>
RESEND_FROM_EMAIL=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=


# Produce execution: worker (recommended) | inline (Vercel poll runs engine — time-limited)
PRODUCE_EXECUTION=worker
PRODUCE_FULL_QUALITY=1
WORKER_TICK_MS=1200000
PRODUCE_JOB_MAX_MS=1800000
