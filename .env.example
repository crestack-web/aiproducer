NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Case-sensitive. Must match Supabase Storage bucket name exactly.
STORAGE_BUCKET=Studio

# Local free UI testing only. Leave unset/false in production.
DEV_MODE=false

# Production: omit or set roex when ROEX_API_KEY is present.
# Local free runs: AUDIO_PIPELINE_MODE=mock
AUDIO_PIPELINE_MODE=roex

MUSIC_GENERATION_MODE=mock
MUSIC_GENERATION_PROVIDER=replicate

REPLICATE_API_TOKEN=
REPLICATE_MUSIC_MODEL_VERSION=671ac645ce5e552cc63a54a2bbff63fcf798043055d2dac5fc9e36a837eedcfb
REPLICATE_MUSICGEN_MODEL_VERSION=stereo-large

MUSIC_PREVIEW_DURATION_SEC=8
MUSIC_FULL_DURATION_SEC=24
MAX_GENERATIONS_PER_USER_PER_DAY=20
MAX_PREVIEW_GENERATIONS_PER_DAY=15
MAX_FULL_GENERATIONS_PER_DAY=5

BEAT_PROVIDER=replicate
ELEVENLABS_API_KEY=

# Required for live mix/master
ROEX_API_KEY=
# false = preview mix/master (default). true = full/paid RoEx outputs when plan allows.
ROEX_ALLOW_FULL=false
# test = preview endpoints only (default). live + ROEX_ALLOW_FULL=true required for paid finals.
ROEX_ENV=test
# Optional webhook auth for POST /api/webhooks/roex
ROEX_WEBHOOK_SECRET=

MISTRAL_API_KEY=

# Optional public callback endpoint for RoEx completion notifications
ROEX_WEBHOOK_URL=
