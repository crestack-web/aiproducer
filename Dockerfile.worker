# AP production worker only — no Next.js build, no React, no full app lockfile.
# Railway: set Dockerfile path to Dockerfile.worker
# Local: docker build -f Dockerfile.worker -t ap-worker .
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV PRODUCE_WORKER=1
ENV PRODUCE_EXECUTION=worker
ENV PATH="/app/node_modules/.bin:${PATH}"

# Minimal dependency set (not the full Next app package.json)
COPY package.worker.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund \
  && test -d node_modules/@supabase/supabase-js \
  && test -x node_modules/.bin/tsx

# Shared pipeline + worker entry (no app/ or components/)
COPY tsconfig.json ./
COPY workers ./workers
COPY lib ./lib

# tsx resolves @/ via tsconfig paths
CMD ["tsx", "workers/production-worker.ts"]
